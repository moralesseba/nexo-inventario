# Copia este archivo como .env y ajusta los valores.
# NUNCA subas el archivo .env real al repositorio: contiene credenciales.

NODE_ENV=development
PORT=3000

# Opción A: cadena de conexión completa (usada por los proveedores Cloud)
# DATABASE_URL=postgres://usuario:password@host:5432/nexo_inventario

# Opción B: variables individuales (usadas por docker-compose en local)
DB_HOST=db
DB_PORT=5432
DB_USER=nexo
DB_PASSWORD=nexo
DB_NAME=nexo_inventario
