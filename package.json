{
  "name": "nexo-inventario",
  "version": "1.2.0",
  "description": "NEXO — Módulo de gestión de inventario. API REST para el sistema de gestión del comercio ALMACÉN DOÑA PATY. DevOps: IaC en Cloud (U2) + monitoreo, pruebas y seguridad DevSecOps (U3).",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "keywords": ["nexo", "inventario", "devops", "cicd", "docker", "iac", "monitoreo", "logging", "devsecops"],
  "author": "Benjamín Nabarro — Sebastián Morales",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
